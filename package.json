{
  "name": "@matteo.collina/tspl",
  "version": "0.2.0",
  "description": "Count the number of assertions for node:test",
  "main": "tspl.js",
  "types": "tspl.d.ts",
  "scripts": {
    "lint": "standard",
    "lint:fix": "standard --fix",
    "test": "npm run test:unit && npm run test:types",
    "test:unit": "node --test test.js && tsd",
    "test:types": "tsd"
  },
  "keywords": [
    "node:test",
    "plan",
    "assert"
  ],
  "author": "Matteo Collina <hello@matteocollina.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcollina/tspl.git"
  },
  "license": "MIT",
  "dependencies": {
  },
  "devDependencies": {
    "@types/node": "^25.2.1",
    "standard": "^17.1.0",
    "tsd": "^0.33.0"
  }
}
