{
  "name": "@matteo.collina/tspl",
  "version": "0.2.0",
  "description": "Count the number of assertions for node:test",
  "main": "tspl.js",
  "types": "tspl.d.ts",
  "scripts": {
    "build:types": "npm run delete:types && tsc --project tsconfig.types.json",
    "delete:types": "node -e \"import { rmSync } from 'fs'; try {rmSync('./tspl.d.ts'); } catch {} \"",
    "lint": "standard",
    "lint:fix": "standard --fix",
    "test": "npm run test:unit && npm run test:types",
    "test:unit": "node --test test.js && tsd",
    "test:types": "tsd"
  },
  "keywords": [
    "node:test",
    "plan",
    "assert"
  ],
  "author": "Matteo Collina <hello@matteocollina.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcollina/tspl.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.4.2",
    "standard": "^17.1.0",
    "tsd": "^0.30.0",
    "typescript": "^5.9.2"
  }
}
