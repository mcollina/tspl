{
    "compilerOptions": {
        "target": "ES2020",
        "module": "esnext",
        "lib": [
            "esnext"
        ],
        "types": [
            "node"
        ],
        "declaration": true,
        "moduleResolution": "node",
        "allowSyntheticDefaultImports": true,
        "allowJs": true,
        "emitDeclarationOnly": true,
        "skipLibCheck": true,
        "checkJs": true,
        "removeComments": true
    },
    "include": [
        "tspl.js"
    ]
}
